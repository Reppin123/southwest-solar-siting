{
  // Southwest siting dashboards as one static site on Cloudflare Workers static assets.
  // Build site-build/ first: /opt/homebrew/bin/uv run --script scripts/build_site.py
  // Deploy (build + deploy + smoke test in one go): scripts/deploy_site.sh
  "name": "southwest-solar-siting",
  "main": "deploy-site/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,

  // site-build/ is served from the edge. Cache headers for data, fonts and deliverables are in
  // site-build/_headers (written by build_site.py). The small worker only runs for /media/*
  // (explainer video) to answer byte-range requests; nothing else invokes it.
  "assets": {
    "directory": "./site-build",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/media/*"]
  }
}
